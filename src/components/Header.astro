---
import { nav, services, site } from "../content";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const W = "M12 20 L32 78 L50 40 L68 78 L88 20";
---
<header class="nav" id="nav">
  <div class="nav-in">
    <a href="/" class="brand" aria-label="Weld, início">
      <svg viewBox="0 0 100 100" class="brand-icon" aria-hidden="true"><path class="brand-w" d={W} /></svg>
      <span>weld</span>
    </a>
    <nav aria-label="Principal" class="nav-main">
      <ul class="nav-links">
        {nav.map((n) => (
          <li class={n.children ? "has-menu" : ""}>
            <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}><span class="roll" data-t={n.label}>{n.label}</span>{n.children && <i class="ph ph-caret-down"></i>}</a>
            {n.children && (
              <div class="mega" role="menu">
                {services.map((s, i) => (
                  <a href={`/servicos/${s.slug}`} class="mega-item" role="menuitem">
                    <span class="mega-n">{String(i + 1).padStart(2, "0")}</span>
                    <span><b>{s.name}</b><small>{s.short}</small></span>
                    <i class="ph ph-arrow-up-right"></i>
                  </a>
                ))}
                <a href="/servicos" class="mega-all">Todos os serviços <i class="ph ph-arrow-right"></i></a>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="nav-right">
      <span class="nav-clock" aria-label="Hora no Porto">Porto <b data-clock>--:--</b></span>
      <a href="/pedido" class="btn btn-mint btn-sm">{site.cta}<i class="ph ph-arrow-right"></i></a>
      <button class="menu-btn" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-lenis-prevent>
    <div class="mm-in">
      <a href="/" class="mm-big">Início</a>
      {nav.map((n) => <a href={n.href} class="mm-big">{n.label}</a>)}
      <p class="mm-label">Serviços</p>
      {services.map((s) => <a href={`/servicos/${s.slug}`} class="mm-sub">{s.name}<i class="ph ph-arrow-up-right"></i></a>)}
      <a href="/contacto?demo" class="btn btn-mint">Pedir demo grátis<i class="ph ph-arrow-right"></i></a>
      <p class="mm-foot"><a href={`tel:+351${site.phone.replace(/\s/g, "")}`}>{site.phone}</a><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></p>
    </div>
  </div>
</header>

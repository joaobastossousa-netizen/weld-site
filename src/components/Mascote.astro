---
import { mascote } from "../content";
---
<div class="soldi" id="soldi" aria-hidden="true">
  <div class="soldi-bal"><span class="soldi-pts"><i></i><i></i><i></i></span><span class="soldi-txt" id="soldi-txt"></span></div>
  <svg class="soldi-svg" viewBox="0 0 120 130" role="img" aria-label={mascote.alt}>
    <defs>
      <radialGradient id="sm-b" cx="35%" cy="25%" r="85%"><stop offset="0" stop-color="#d4f9e6" /><stop offset=".55" stop-color="#94e2bc" /><stop offset="1" stop-color="#55c392" /></radialGradient>
      <radialGradient id="sm-s" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#fff6c2" /><stop offset=".5" stop-color="#ffd66b" /><stop offset="1" stop-color="#ffd66b" stop-opacity="0" /></radialGradient>
    </defs>
    <ellipse class="sm-sombra" cx="60" cy="119" rx="30" ry="5" fill="#000" opacity=".25" />
    <g class="sm-corpo">
      <g class="sm-cauda">
        <path d="M92 104 C112 106 116 86 108 72 C104 65 106 58 110 54" stroke="#55c392" stroke-width="8" fill="none" stroke-linecap="round" />
        <path d="M92 104 C112 106 116 86 108 72" stroke="#94e2bc" stroke-width="3" fill="none" stroke-linecap="round" opacity=".6" />
        <g class="sm-faisca">
          <circle cx="110" cy="50" r="10" fill="url(#sm-s)" /><circle cx="110" cy="50" r="4.6" fill="#ffd66b" /><circle cx="108.6" cy="48.6" r="1.5" fill="#fff" />
          <path class="sm-brilho" d="M116 36 L117.2 39.2 L120.4 40.4 L117.2 41.6 L116 44.8 L114.8 41.6 L111.6 40.4 L114.8 39.2Z" fill="#ffe9a0" />
          <path class="sm-brilho sm-b2" d="M102 38 L102.8 40.2 L105 41 L102.8 41.8 L102 44 L101.2 41.8 L99 41 L101.2 40.2Z" fill="#fff6c2" />
        </g>
      </g>
      <g class="sm-orelha sm-ol"><path d="M24 52 C20 30 24 14 30 10 C40 12 52 22 56 34 Z" fill="#6fd0a2" /><path d="M30 44 C28 30 30 22 33 19 C40 21 46 27 49 34 Z" fill="#ffb3c6" /></g>
      <g class="sm-orelha sm-or"><path d="M96 52 C100 30 96 14 90 10 C80 12 68 22 64 34 Z" fill="#6fd0a2" /><path d="M90 44 C92 30 90 22 87 19 C80 21 74 27 71 34 Z" fill="#ffb3c6" /></g>
      <ellipse cx="42" cy="112" rx="10" ry="6.5" fill="#6fd0a2" /><ellipse cx="78" cy="112" rx="10" ry="6.5" fill="#6fd0a2" />
      <path d="M60 26 C94 26 108 50 108 76 C108 100 90 115 60 115 C30 115 12 100 12 76 C12 50 26 26 60 26Z" fill="url(#sm-b)" />
      <ellipse cx="36" cy="44" rx="13" ry="6.5" fill="#fff" opacity=".5" transform="rotate(-28 36 44)" />
      <ellipse cx="60" cy="102" rx="19" ry="11" fill="#eafff4" opacity=".75" />
      <path d="M60 30 L60 40 M51 31 L53 39 M69 31 L67 39" stroke="#55c392" stroke-width="2.6" stroke-linecap="round" opacity=".75" />
      <g class="sm-olhos">
        <ellipse cx="41" cy="70" rx="9" ry="11.5" fill="#1d4a39" /><ellipse cx="79" cy="70" rx="9" ry="11.5" fill="#1d4a39" />
        <g class="sm-olhar">
          <ellipse cx="41" cy="72" rx="6.4" ry="8.6" fill="#0d2a20" /><ellipse cx="79" cy="72" rx="6.4" ry="8.6" fill="#0d2a20" />
          <circle cx="44" cy="66" r="3.8" fill="#fff" /><circle cx="82" cy="66" r="3.8" fill="#fff" /><circle cx="38.4" cy="76" r="1.9" fill="#fff" /><circle cx="76.4" cy="76" r="1.9" fill="#fff" />
        </g>
      </g>
      <ellipse cx="25" cy="86" rx="7" ry="4.3" fill="#ff9fb5" opacity=".85" /><ellipse cx="95" cy="86" rx="7" ry="4.3" fill="#ff9fb5" opacity=".85" />
      <path d="M56.5 82 L63.5 82 L60 86.4 Z" fill="#ff7f9d" stroke="#ff7f9d" stroke-width="1.6" stroke-linejoin="round" />
      <path class="sm-boca" d="M60 87 Q60 92 54.5 92 M60 87 Q60 92 65.5 92" stroke="#2c6b53" stroke-width="2.2" fill="none" stroke-linecap="round" />
      <path d="M13 80 L2 77 M13 85 L1 86 M14 90 L4 95 M107 80 L118 77 M107 85 L119 86 M106 90 L116 95" stroke="#c8f1dc" stroke-width="1.8" stroke-linecap="round" />
    </g>
  </svg>
</div>

<style is:global>
  .soldi{position:fixed;left:clamp(10px,2vw,26px);bottom:clamp(10px,2vw,24px);z-index:55;width:clamp(64px,7vw,92px);pointer-events:none;transition:opacity .5s,transform .6s cubic-bezier(.2,.8,.2,1)}
  .soldi.is-off{opacity:0;transform:translateY(16px)}
  .soldi-svg{display:block;width:100%;height:auto;overflow:visible;filter:drop-shadow(0 12px 18px rgba(0,0,0,.35))}
  .soldi-bal{position:absolute;left:calc(100% - 14px);bottom:calc(100% - 22px);min-width:54px;max-width:min(230px,58vw);padding:9px 13px;border-radius:16px 16px 16px 4px;background:#F4F7F4;color:#0A2119;font:500 13px/1.3 "IBM Plex Mono",ui-monospace,monospace;letter-spacing:-.01em;box-shadow:0 14px 30px -14px rgba(0,0,0,.6),inset 0 0 0 1px rgba(10,33,25,.1);opacity:0;transform:translateY(6px) scale(.96);transform-origin:0 100%;transition:opacity .35s,transform .45s cubic-bezier(.2,.8,.2,1)}
  .soldi.has-bal .soldi-bal{opacity:1;transform:none}
  .soldi-pts{display:inline-flex;gap:4px;align-items:center;height:16px}
  .soldi-pts i{width:6px;height:6px;border-radius:50%;background:#3FA47A;animation:sm-ponto 1s ease-in-out infinite}
  .soldi-pts i:nth-child(2){animation-delay:.15s}.soldi-pts i:nth-child(3){animation-delay:.3s}
  .soldi-txt{display:none}
  .soldi.diz .soldi-pts{display:none}.soldi.diz .soldi-txt{display:inline}
  .sm-corpo{transform-origin:60px 114px;transform-box:view-box;animation:sm-respira 3.4s ease-in-out infinite}
  .sm-sombra{transform-origin:60px 119px;transform-box:view-box;animation:sm-sombra 3.4s ease-in-out infinite}
  .sm-olhos{transform-origin:60px 72px;transform-box:view-box;animation:sm-pisca 5.2s infinite}
  .sm-olhar{animation:sm-olhar 6.4s ease-in-out infinite}
  .sm-cauda{transform-origin:92px 104px;transform-box:view-box;animation:sm-cauda 2.6s ease-in-out infinite}
  .sm-orelha{transform-box:fill-box;transform-origin:50% 100%}
  .sm-ol{animation:sm-orelha 5.2s ease-in-out infinite}.sm-or{animation:sm-orelha 5.2s ease-in-out 2.4s infinite reverse}
  .sm-brilho{transform-box:fill-box;transform-origin:center;opacity:0;animation:sm-brilha 2.4s ease-in-out infinite}.sm-b2{animation-delay:1.1s}
  @keyframes sm-respira{0%,100%{transform:translateY(0) scale(1,1)}50%{transform:translateY(-3px) scale(1.015,.985)}}
  @keyframes sm-sombra{0%,100%{transform:scaleX(1)}50%{transform:scaleX(.92)}}
  @keyframes sm-pisca{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.08)}}
  @keyframes sm-olhar{0%,8%{transform:translate(0,-2px)}20%,34%{transform:translate(-2.6px,-3px)}46%,58%{transform:translate(2.8px,-3px)}70%,82%{transform:translate(0,2px)}94%,100%{transform:translate(0,-2px)}}
  @keyframes sm-cauda{0%,100%{transform:rotate(-7deg)}50%{transform:rotate(11deg)}}
  @keyframes sm-orelha{0%,88%,100%{transform:rotate(0)}92%{transform:rotate(-9deg)}96%{transform:rotate(3deg)}}
  @keyframes sm-brilha{0%,100%{opacity:0;transform:scale(.3) rotate(0)}50%{opacity:1;transform:scale(1) rotate(25deg)}}
  @keyframes sm-ponto{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-4px);opacity:1}}
  @media (prefers-reduced-motion:reduce){.soldi *{animation:none!important}.sm-brilho{opacity:.8}}
</style>

<script define:vars={{ frases: mascote.frases }}>
  (function () {
    var el = document.getElementById("soldi"), txt = document.getElementById("soldi-txt");
    if (!el || !txt) return;
    var reduz = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // desaparece quando o rodapé está à vista, para não tapar nada
    var foot = document.querySelector(".footer");
    if (foot && "IntersectionObserver" in window) new IntersectionObserver(function (e) { el.classList.toggle("is-off", e[0].isIntersecting); }, { threshold: 0.15 }).observe(foot);
    if (reduz) { txt.textContent = frases[0]; el.classList.add("has-bal", "diz"); return; }
    var i = Math.floor(Math.random() * frases.length);
    function pensa() {
      el.classList.remove("diz"); el.classList.add("has-bal");
      setTimeout(function () {
        txt.textContent = frases[i % frases.length] + "…"; i++;
        el.classList.add("diz");
        setTimeout(function () { el.classList.remove("has-bal"); setTimeout(pensa, 700); }, 3000);
      }, 1500);
    }
    setTimeout(pensa, 1800);
  })();
</script>

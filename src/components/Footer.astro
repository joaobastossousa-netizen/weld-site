---
import { site, services, nav } from "../content";
---
<footer class="footer" data-chapter="dark">
  <div class="wrap foot-grid">
    <p class="foot-say">Trabalho repetido, feito à mão? <a href="/contacto?demo" class="u-link">Mostra-nos.</a></p>
    <div><p class="foot-h">Serviços</p>{services.map((s) => <a href={`/servicos/${s.slug}`}>{s.name}</a>)}</div>
    <div><p class="foot-h">Weld</p>{nav.filter((n) => !n.children).map((n) => <a href={n.href}>{n.label}</a>)}<a href="/pedido">Fazer um pedido</a></div>
    <div><p class="foot-h">Contacto</p><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:+351${site.phone.replace(/\s/g, "")}`}>{site.phone}</a><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a></div>
  </div>
  <div class="foot-mark" aria-hidden="true"><span>weld</span></div>
  <div class="wrap foot-bottom">
    <span>© 2026 Weld · Assistentes de IA, automações e sites</span>
    <span class="foot-geo">41,15° N · 8,61° O</span>
    <span>Porto <b data-clock>--:--</b></span>
    <a href="#conteudo" class="foot-top">Voltar ao topo<i class="ph ph-arrow-up"></i></a>
  </div>
</footer>

---
import { site } from "../content";
interface Props { title?: string; text?: string }
const { title = "Queres ver isto no teu negócio?", text = "Fazemos uma demo personalizada, de graça. Apresentamos em 20 minutos e, se fizer sentido, enviamos a proposta." } = Astro.props;
const W = "M12 20 L32 78 L50 40 L68 78 L88 20";
---
<section class="wrap cta-wrap">
  <div class="cta-band dark reveal">
    <svg class="cta-w" viewBox="0 0 100 100" aria-hidden="true"><path d={W} /></svg>
    <div>
      <h2 class="h2">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-actions">
      <a href="/contacto?demo" class="btn btn-mint magnetic">Pedir demo grátis<i class="ph ph-arrow-right"></i></a>
      <a href="/pedido" class="btn btn-ghost">Já sei o que quero</a>
    </div>
  </div>
</section>

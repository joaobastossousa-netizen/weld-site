---
// Fecho de todas as páginas: frase enorme, botão redondo e as alternativas.
import { site, landing } from "../content";
interface Props { title?: string; text?: string }
const { text = landing.cta.text } = Astro.props;
---
<section class="cta5" data-chapter="dark">
  <div class="wrap-wide cta5-in">
    <h2 class="cta5-h" data-rise>
      <span class="ln"><span>{landing.cta.title[0]}</span></span>
      <span class="ln ln-hot"><span>{landing.cta.title[1]}<svg class="cta5-seam" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true"><path d="M4 26 C 120 8, 220 36, 330 20 S 520 10, 596 22" pathLength="1" data-draw /></svg></span></span>
    </h2>
    <div class="cta5-side">
      <p>{text}</p>
      <a href="/contacto?demo" class="orb magnetic" data-cursor="Vamos a isso"><span>Pedir demo<br />grátis</span><i class="ph ph-arrow-up-right"></i></a>
      <div class="cta5-alt">
        <a href="/pedido" class="u-link">Já sei o que quero<i class="ph ph-arrow-right"></i></a>
        <a href={`tel:+351${site.phone.replace(/\s/g, "")}`} class="u-link">{site.phone}</a>
      </div>
      <p class="cta5-who">Respondes ao João, não a um robô. Normalmente no próprio dia.</p>
    </div>
  </div>
</section>

---
import Base from "../../layouts/Base.astro";
import DemoOffer from "../../components/DemoOffer.astro";
import Faq from "../../components/Faq.astro";
import CtaBand from "../../components/CtaBand.astro";
import { sectorPages, site } from "../../content";

export function getStaticPaths() {
  return sectorPages.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const others = sectorPages.filter((o) => o.slug !== s.slug);
---
<Base title={`Assistente de IA e automação para ${s.name.toLowerCase()} no Porto · Weld`} description={s.lead}>
  <section class="page-hero wrap">
    <nav class="crumbs load" aria-label="Caminho"><a href="/">Início</a><i class="ph ph-caret-right"></i><a href="/servicos">Serviços</a><i class="ph ph-caret-right"></i><span>{s.name}</span></nav>
    <p class="kicker load" style="--d:1"><span class="dot"></span>{s.name}</p>
    <h1 class="h1 load" style="--d:2">{s.title}</h1>
    <p class="lead load" style="--d:3">{s.lead}</p>
    <div class="hero-ctas load" style="--d:4">
      <a href="/contacto?demo" class="btn btn-mint magnetic"><i class="ph ph-gift"></i>Pedir demo grátis</a>
      <a href="/contacto" class="btn btn-ghost">{site.cta}<i class="ph ph-arrow-right"></i></a>
    </div>
  </section>

  <section class="section wrap">
    <div class="sec-head"><h2 class="h2 reveal">O que costuma custar tempo.</h2></div>
    <div class="chips">{s.pains.map((p, i) => <span class="chip-lg" style={`--i:${i}`}>{p}</span>)}</div>
  </section>

  <section class="section wrap">
    <div class="sec-head"><h2 class="h2 reveal">O que montamos.</h2></div>
    <div class="features">
      {s.builds.map(([icon, t, p, href], i) => (
        href ? (
          <a href={href} class="feature card-fx reveal" style={`--i:${i}`}>
            <span class="svc-icon"><i class={`ph-duotone ${icon}`}></i></span>
            <h3>{t}</h3>
            <p>{p}</p>
          </a>
        ) : (
          <article class="feature card-fx reveal" style={`--i:${i}`}>
            <span class="svc-icon"><i class={`ph-duotone ${icon}`}></i></span>
            <h3>{t}</h3>
            <p>{p}</p>
          </article>
        )
      ))}
    </div>
  </section>

  <DemoOffer />

  <Faq items={s.faq} />

  <section class="section wrap">
    <div class="sec-head"><h2 class="h2 reveal">Outros setores.</h2></div>
    <div class="chips">
      {others.map((o, i) => <a href={`/setores/${o.slug}`} class="chip-lg" style={`--i:${i}`}>{o.name}</a>)}
    </div>
  </section>
  <CtaBand />
</Base>

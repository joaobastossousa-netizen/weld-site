---
import Base from "../layouts/Base.astro";
import Ways from "../components/Ways.astro";
import Examples from "../components/Examples.astro";
import DemoOffer from "../components/DemoOffer.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { sectors, home, integrations, story, services, demos, agencies, compare, stats, process, faq, site } from "../content";
const W = "M12 20 L32 78 L50 40 L68 78 L88 20";
---
<Base title="Weld · Assistentes de IA para agências e negócios" description={home.lead}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-top load" style="--d:0">
        <p class="kicker"><span class="dot"></span>{home.kicker}</p>
        <p class="hero-meta"><span>Para agências</span><span>Para negócios</span></p>
      </div>
      <h1 class="h1 hero-h1">
        <span class="line"><span class="in" style="--d:1">{home.line1}</span></span>
        <span class="line"><span class="in" style="--d:2">{home.line2} <span class="rotator" aria-live="polite">{home.rotate.map((w, i) => <span class={`rot${i === 0 ? " on" : ""}`}>{w}</span>)}</span></span></span>
      </h1>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lead load" style="--d:4">{home.lead}</p>
          <div class="hero-ctas load" style="--d:5">
            <a href="/contacto" class="btn btn-mint magnetic">{site.cta}<i class="ph ph-arrow-right"></i></a>
            <a href="/contacto?demo" class="btn btn-ghost"><i class="ph ph-gift"></i>Pedir demo grátis</a>
          </div>
          <div class="hero-paths load" style="--d:6">
            <a href="/agencias"><i class="ph-duotone ph-megaphone"></i><span><b>Sou uma agência</b><small>Revender com o meu nome</small></span><i class="ph ph-arrow-up-right"></i></a>
            <a href="/servicos"><i class="ph-duotone ph-storefront"></i><span><b>Tenho um negócio</b><small>Contratar diretamente</small></span><i class="ph ph-arrow-up-right"></i></a>
          </div>
        </div>
        <div class="hero-photo load" style="--d:3">
          <div class="hp-frame img-reveal"><img src="/img/hero.jpg" alt="Dono de um negócio a ver uma mensagem no telemóvel" width="1400" height="1600" class="hp-img" data-zoom /></div>
          <div class="hp-card hp-msg" data-drift="-70">
            <img src="/logos/whatsapp-color.svg" alt="" width="30" height="30" />
            <span><small>Assistente de IA · 23:14</small><b>Vaga marcada: sábado às 10h</b></span>
          </div>
          <div class="hp-card hp-reply" data-drift="-140">
            <span class="hp-ic"><i class="ph-bold ph-flow-arrow"></i></span>
            <span><small>Automação · agora</small><b>Fatura enviada e lançada no Excel</b></span>
          </div>
          <div class="hp-card hp-booked" data-drift="-40">
            <span class="hp-ic web"><i class="ph-bold ph-browser"></i></span>
            <span><small>Site · novo pedido</small><b>Orçamento pedido por Ana Costa</b></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DUAS FORMAS -->
  <Ways idx="01 / Como trabalhamos" />

  <!-- EXEMPLOS DOS QUATRO SERVIÇOS -->
  <Examples idx="02 / Exemplos" />

  <!-- SETORES: galeria horizontal presa ao scroll -->
  <section class="sectors" id="setores">
    <div class="sectors-pin">
      <div class="wrap sectors-head">
        <p class="idx">03 / {sectors.idx}</p>
        <h2 class="h2">{sectors.title}</h2>
        <p class="lead">{sectors.lead}</p>
      </div>
      <div class="sectors-track">
        {sectors.items.map((it, i) => (
          <article class="sector" style={`--i:${i}`}>
            <img src={`/img/${it.img}`} alt={it.name} width="900" height="1150" loading="lazy" class="sector-img" />
            <span class="sector-tag">{it.tag}</span>
            <div class="sector-chat" aria-hidden="true">
              {it.events.map(([ic, txt], k) => <span class={`sc-e ${k ? "bot" : "me"}`}><i class={`ph-bold ${ic}`}></i>{txt}</span>)}
            </div>
            <h3>{it.name}</h3>
          </article>
        ))}
        <article class="sector sector-end">
          <svg class="se-w" viewBox="0 0 100 100" aria-hidden="true"><path d="M12 20 L32 78 L50 40 L68 78 L88 20" /></svg>
          <h3>O teu setor não está aqui?</h3>
          <p>Se os teus clientes escrevem, dá para automatizar. Conta-nos como trabalhas.</p>
          <a href="/contacto" class="btn">Falar connosco<i class="ph ph-arrow-right"></i></a>
        </article>
      </div>
    </div>
  </section>

  <!-- FERRAMENTAS -->
  <section class="wrap tools" aria-label={integrations.title}>
    <p class="tools-title">{integrations.title}</p>
    <ul class="tool-grid">
      {integrations.items.slice(0, 8).map(([slug, name], i) => <li class="tool reveal" style={`--i:${i}`}><img src={`/logos/${slug}.svg`} alt="" width="22" height="22" loading="lazy" /><span>{name}</span></li>)}
    </ul>
  </section>

  <!-- SERVIÇOS -->
  <section class="section wrap" id="servicos">
    <div class="sec-head">
      <p class="idx reveal">04 / Serviços</p>
      <h2 class="h2 reveal">O que construímos.</h2>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <a href={`/servicos/${s.slug}`} class="svc-row reveal" style={`--i:${i}`} data-img={`/img/svc-${s.slug.split("-")[0]}.jpg`}>
          <span class="svc-num">{String(i + 1).padStart(2, "0")}</span>
          <span class="svc-icon"><i class={`ph-duotone ${s.icon}`}></i></span>
          <span class="svc-row-txt"><h3>{s.name}</h3><p>{s.card}</p></span>
          <span class="svc-go"><i class="ph ph-arrow-up-right"></i></span>
        </a>
      ))}
    </div>
    <div class="svc-preview" aria-hidden="true"><img alt="" /></div>
  </section>

  <div class="dark band">
  <!-- MÁQUINA -->
  <section class="section wrap">
    <div class="sec-head">
      <p class="idx reveal">05 / Como funciona</p>
      <h2 class="h2 reveal">Entra um pedido. Sai tudo tratado.</h2>
    </div>
    <div class="machine reveal" aria-label="Mensagens de clientes transformadas em marcações e pedidos">
      <div class="lane lane-in">
        {home.flow.inputs.map((m) => <div class="msg"><img src={`/logos/${m.icon}.svg`} alt="" width="18" height="18" /><span>{m.text}</span></div>)}
      </div>
      <div class="core">
        <svg viewBox="0 0 100 100" aria-hidden="true"><rect width="100" height="100" rx="26" class="core-bg" /><path d={W} class="core-w" /></svg>
        <span class="core-label">weld</span>
      </div>
      <div class="lane lane-out">
        {home.flow.outputs.map((o) => <div class="out"><span class="tick" aria-hidden="true"></span><span>{o}</span></div>)}
      </div>
      <svg class="wires" viewBox="0 0 600 360" preserveAspectRatio="none" aria-hidden="true">
        <path d="M190 70 C 250 70, 250 180, 300 180" /><path d="M190 180 L 300 180" /><path d="M190 290 C 250 290, 250 180, 300 180" />
        <path d="M300 180 C 350 180, 350 70, 410 70" /><path d="M300 180 L 410 180" /><path d="M300 180 C 350 180, 350 290, 410 290" />
      </svg>
    </div>
  </section>

  <!-- CALCULADORA: quanto tempo estás a perder -->
  <section class="section wrap calc" id="calculadora">
    <div class="sec-head">
      <p class="idx reveal">Calculadora</p>
      <h2 class="h2 reveal">Quanto tempo estás a perder?</h2>
      <p class="lead reveal">Mexe nos valores do teu negócio. Fazemos as contas ao tempo que hoje vai para trabalho que dá para automatizar.</p>
    </div>
    <div class="calc-box reveal">
      <div class="calc-in">
        <label class="rng"><span><b>Mensagens de clientes por dia</b><output data-o="msg">40</output></span><input type="range" min="0" max="200" step="5" value="40" data-k="msg" /></label>
        <label class="rng"><span><b>Minutos por resposta</b><output data-o="min">4</output></span><input type="range" min="1" max="15" step="1" value="4" data-k="min" /></label>
        <label class="rng"><span><b>Horas por semana em tarefas repetidas</b><small>copiar dados, faturas, relatórios</small><output data-o="rep">6</output></span><input type="range" min="0" max="40" step="1" value="6" data-k="rep" /></label>
        <label class="rng"><span><b>Custo de uma hora da equipa</b><output data-o="eur">12 €</output></span><input type="range" min="6" max="50" step="1" value="12" data-k="eur" /></label>
      </div>
      <div class="calc-out">
        <p class="co-k">Por mês, vai para trabalho automatizável</p>
        <p class="co-h"><b data-r="hours">0</b><span>horas</span></p>
        <div class="co-bars">
          <span><i data-bar="msg"></i><small>Mensagens</small><em data-r="hmsg">0 h</em></span>
          <span><i data-bar="rep"></i><small>Tarefas repetidas</small><em data-r="hrep">0 h</em></span>
        </div>
        <p class="co-e">≈ <b data-r="eur">0 €</b> em tempo da equipa, todos os meses</p>
        <p class="co-d"><b data-r="days">0</b> dias de trabalho por mês</p>
        <a href="/contacto?demo" class="btn btn-mint magnetic">Ver isto a funcionar no meu negócio<i class="ph ph-arrow-right"></i></a>
        <p class="co-note">Estimativa com os números que puseste, a contar 22 dias úteis por mês.</p>
      </div>
    </div>
  </section>
  </div>

  <!-- O QUE MUDA -->
  <section class="section wrap">
    <div class="sec-head"><p class="idx reveal">06 / O que muda</p><h2 class="h2 reveal">{compare.title}</h2></div>
    <div class="compare">
      <div class="cmp cmp-no reveal">
        <p class="cmp-h"><i class="ph ph-x-circle"></i>Sem assistente</p>
        <ul>{compare.without.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="cmp cmp-yes reveal" style="--i:1">
        <p class="cmp-h"><i class="ph-fill ph-check-circle"></i>Com a Weld</p>
        <ul>{compare.with.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- NÚMEROS -->
  <section class="stats-band">
    <div class="wrap stats">
      {stats.map(([n, l], i) => <div class="stat reveal" style={`--i:${i}`}><b class="count" data-count={n}>{n}</b><span>{l}</span></div>)}
    </div>
  </section>

  <!-- DEMOS -->
  <section class="section wrap" id="demos">
    <div class="sec-head">
      <p class="idx reveal">07 / Demos</p>
      <h2 class="h2 reveal">{demos.title}</h2>
      <p class="lead reveal">{demos.lead}</p>
    </div>
    <div class="showcase reveal">
      <div class="demo-list" role="tablist" aria-label="Demos">
        {demos.items.map((d, i) => (
          <button class={`demo-item${i === 0 ? " on" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} style={`--c:${d.color};--ink:${d.ink}`}>
            <span class="demo-mark">{d.brand.charAt(0)}</span>
            <span class="demo-txt"><b>{d.brand}</b><small>{d.sector}</small></span>
            <span class="demo-bar"><i></i></span>
          </button>
        ))}
        <p class="demo-note">{demos.note}</p>
      </div>
      <div class="demo-stage">
        <div class="browser">
          <div class="browser-bar"><i></i><i></i><i></i><span class="demo-url">weldstudio.pt/demos/{demos.items[0].slug}</span></div>
          <div class="browser-view">
            {demos.items.map((d, i) => <video class={`demo-video${i === 0 ? " on" : ""}`} src={`/videos/${d.slug}.mp4`} poster={`/videos/${d.slug}.jpg`} muted playsinline preload={i === 0 ? "auto" : "none"} aria-label={`Vídeo da demo ${d.brand}`}></video>)}
          </div>
        </div>
        <div class="demo-info">
          {demos.items.map((d, i) => (
            <div class={`demo-desc${i === 0 ? " on" : ""}`} data-slug={d.slug}>
              <p>{d.what}</p>
              <a class="btn btn-mint magnetic" href={`/demos/${d.slug}/index.html`} target="_blank" rel="noopener">Experimentar<i class="ph ph-arrow-up-right"></i></a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- DEMO GRÁTIS -->
  <DemoOffer idx="Demo grátis" />

  <!-- AGÊNCIAS -->
  <section class="section wrap">
    <div class="agency-teaser dark reveal">
      <div>
        <p class="idx">08 / {agencies.kicker}</p>
        <h2 class="h2">{agencies.title}</h2>
        <p class="lead">{agencies.lead}</p>
        <a href="/agencias" class="btn btn-mint magnetic">Como funciona para agências<i class="ph ph-arrow-right"></i></a>
      </div>
      <div class="agency-photo">
        <div class="img-reveal ap-frame"><img src="/img/agencias.jpg" alt="Equipa de uma agência a trabalhar" width="1200" height="900" loading="lazy" data-zoom /></div>
        <div class="diagram ap-diagram" aria-hidden="true" data-drift="-50">
          {agencies.flow.map((n, i) => <>{i > 0 && <span class="d-wire"><i></i></span>}<span class={`d-node${n === "Weld" ? " weld" : ""}`}>{n === "Weld" ? <svg viewBox="0 0 100 100"><path d={W} /></svg> : <i class={`ph-duotone ${i === 0 ? "ph-megaphone" : "ph-storefront"}`}></i>}{n}</span></>)}
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESSO -->
  <section class="section wrap">
    <div class="sec-head"><p class="idx reveal">09 / Processo</p><h2 class="h2 reveal">{process.title}</h2></div>
    <ol class="steps">
      <span class="steps-line" aria-hidden="true"><span class="steps-fill"></span></span>
      {process.steps.map((s, i) => (
        <li class="step reveal" style={`--i:${i}`}><span class="step-n"><i class={`ph-bold ${s.icon}`}></i></span><span class="step-k">{String(i + 1).padStart(2, "0")}</span><h3>{s.name}</h3><p>{s.text}</p></li>
      ))}
    </ol>
  </section>

  <Faq items={faq.items} />
  <CtaBand />
</Base>

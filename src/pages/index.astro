---
import Base from "../layouts/Base.astro";
import { contacts, team, hero, flow, integrations, story, demos, paths, services, process, deals, faq, contact } from "../content";

const W = "M12 20 L32 78 L50 40 L68 78 L88 20";
const arrow = `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const icon = (name: string) => `<img src="/logos/${name}.svg" alt="" width="20" height="20" loading="lazy" />`;
---
<Base title="Weld · Assistentes de IA para agências e negócios" description={hero.lead}>
  <div class="grain" aria-hidden="true"></div>

  <header class="nav" id="nav">
    <div class="wrap nav-in">
      <a href="#topo" class="brand" aria-label="Weld, início">
        <svg viewBox="0 0 100 100" class="brand-icon" aria-hidden="true"><rect width="100" height="100" rx="22" fill="#0A2119" /><path class="brand-w" d={W} /></svg>
        <span>weld</span>
      </a>
      <nav aria-label="Principal">
        <ul class="nav-links">
          <li><a href="#demos">Demos</a></li>
          <li><a href="#caminhos">Para agências</a></li>
          <li><a href="#servicos">Serviços</a></li>
          <li><a href="#negocio">Modelos</a></li>
          <li><a href="#equipa">Equipa</a></li>
        </ul>
      </nav>
      <a href="#contacto" class="btn btn-dark btn-sm magnetic">Falar connosco</a>
    </div>
  </header>

  <main id="topo">
    <!-- HERO -->
    <section class="hero">
      <div class="blob b1" aria-hidden="true"></div>
      <div class="blob b2" aria-hidden="true"></div>
      <div class="wrap hero-in">
        <div class="hero-copy">
          <p class="kicker load" style="--d:0"><span class="dot"></span>{hero.kicker}</p>
          <h1 class="h1">
            <span class="line"><span class="in" style="--d:1">{hero.line1}</span></span>
            <span class="line"><span class="in" style="--d:2">{hero.line2} <span class="rotator" id="rotator" aria-live="polite">{hero.rotate.map((w, i) => <span class={`rot${i === 0 ? " on" : ""}`}>{w}</span>)}</span></span></span>
          </h1>
          <p class="lead load" style="--d:4">{hero.lead}</p>
          <div class="hero-ctas load" style="--d:5">
            <a href="#demos" class="btn btn-dark magnetic">Ver as demos<Fragment set:html={arrow} /></a>
            <a href="#caminhos" class="btn btn-line" data-path="agency">{hero.agency}</a>
            <a href="#caminhos" class="btn btn-line" data-path="business">{hero.business}</a>
          </div>
        </div>

        <!-- mensagens entram, o W solda, resultados saem -->
        <div class="machine load" style="--d:3" aria-label="Mensagens de clientes transformadas em marcações e pedidos">
          <div class="lane lane-in">
            {flow.inputs.map((m, i) => <div class="msg" data-i={i}><Fragment set:html={icon(m.icon)} /><span>{m.text}</span></div>)}
          </div>
          <div class="core">
            <svg viewBox="0 0 100 100" aria-hidden="true"><rect width="100" height="100" rx="26" class="core-bg" /><path d={W} class="core-w" /><circle cx="50" cy="40" r="5" class="core-spark" /></svg>
            <span class="core-label">weld</span>
          </div>
          <div class="lane lane-out">
            {flow.outputs.map((o, i) => <div class="out" data-i={i}><span class="tick" aria-hidden="true"></span><span>{o}</span></div>)}
          </div>
          <svg class="wires" viewBox="0 0 600 360" preserveAspectRatio="none" aria-hidden="true">
            <path d="M190 70 C 250 70, 250 180, 300 180" /><path d="M190 180 L 300 180" /><path d="M190 290 C 250 290, 250 180, 300 180" />
            <path d="M300 180 C 350 180, 350 70, 410 70" /><path d="M300 180 L 410 180" /><path d="M300 180 C 350 180, 350 290, 410 290" />
          </svg>
        </div>
      </div>

      <div class="logos" aria-label={integrations.title}>
        <p class="logos-title">{integrations.title}</p>
        <div class="marquee"><div class="marquee-track">
          {[...integrations.items, ...integrations.items].map(([slug, name]) => <span class="logo"><img src={`/logos/${slug}.svg`} alt={name} width="22" height="22" loading="lazy" /><span>{name}</span></span>)}
        </div></div>
      </div>
    </section>

    <!-- HISTÓRIA COM SCROLL -->
    <section class="story" id="historia">
      <div class="story-pin">
        <div class="wrap story-in">
          <div class="story-copy">
            <h2 class="h2 reveal">{story.title}</h2>
            <ol class="story-steps">
              {story.steps.map((s, i) => (
                <li class={`s-step${i === 0 ? " on" : ""}`} data-step={i}>
                  <span class="s-time">{s.time}</span>
                  <div><h3>{s.title}</h3><p>{s.text}</p></div>
                </li>
              ))}
            </ol>
          </div>
          <div class="stage" aria-hidden="true">
            <div class="stage-phone">
              <div class="sp-head"><span class="sp-av"></span><div><b>A tua loja</b><small id="sp-status">fechada · 23:14</small></div></div>
              <div class="sp-body">
                <div class="sb me s1">Olá! Têm vaga para sábado de manhã?</div>
                <div class="sb bot s2">Olá! Sábado tenho às 10:00 e às 11:30. Qual prefere?</div>
                <div class="sb me s2b">10h, por favor. Sou a Rita.</div>
                <div class="sb bot s2c">Está marcado, Rita! Sábado às 10:00.</div>
              </div>
            </div>
            <div class="stage-panel">
              <div class="spn-head"><b>Painel</b><span class="live">Ao vivo</span></div>
              <div class="spn-row old"><b>09:30</b><span>Marta · Revisão</span></div>
              <div class="spn-row new s3"><b>10:00</b><span>Rita · Nova marcação</span><em>nova</em></div>
              <div class="spn-row old"><b>14:30</b><span>Nuno · Orçamento</span></div>
            </div>
            <div class="stage-moon s1" id="moon"><i class="ph-fill ph-moon-stars"></i>Loja fechada</div>
            <div class="stage-toast s3">Nova marcação feita pelo assistente</div>
          </div>
        </div>
      </div>
    </section>

    <!-- DEMOS -->
    <section class="section wrap" id="demos">
      <div class="head">
        <h2 class="h2 reveal">{demos.title}</h2>
        <p class="lead reveal">{demos.lead}</p>
      </div>
      <div class="showcase reveal">
        <div class="demo-list" role="tablist" aria-label="Demos">
          {demos.items.map((d, i) => (
            <button class={`demo-item${i === 0 ? " on" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} data-demo={i} style={`--c:${d.color};--ink:${d.ink}`}>
              <span class="demo-mark">{d.brand.charAt(0)}</span>
              <span class="demo-txt"><b>{d.brand}</b><small>{d.sector}</small></span>
              <span class="demo-bar"><i></i></span>
            </button>
          ))}
          <p class="demo-note">{demos.note}</p>
        </div>
        <div class="demo-stage">
          <div class="browser">
            <div class="browser-bar"><i></i><i></i><i></i><span id="demo-url">weld-site.vercel.app/demos/{demos.items[0].slug}</span></div>
            <div class="browser-view">
              {demos.items.map((d, i) => (
                <video class={`demo-video${i === 0 ? " on" : ""}`} data-demo={i} src={`/videos/${d.slug}.mp4`} poster={`/videos/${d.slug}.jpg`} muted playsinline loop preload={i === 0 ? "auto" : "none"} aria-label={`Vídeo da demo ${d.brand}`}></video>
              ))}
            </div>
          </div>
          <div class="demo-info">
            {demos.items.map((d, i) => (
              <div class={`demo-desc${i === 0 ? " on" : ""}`} data-demo={i}>
                <p>{d.what}</p>
                <a class="btn btn-dark magnetic" href={`/demos/${d.slug}/index.html`} target="_blank" rel="noopener">Experimentar esta demo<Fragment set:html={arrow} /></a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CAMINHOS -->
    <section class="section wrap" id="caminhos">
      <h2 class="h2 reveal">{paths.title}</h2>
      <div class="switch reveal" role="tablist" aria-label="Escolhe o teu caso">
        <span class="switch-pill" aria-hidden="true"></span>
        <button role="tab" id="tab-agency" aria-controls="panel-agency" aria-selected="true" data-tab="agency">{paths.agency.tab}</button>
        <button role="tab" id="tab-business" aria-controls="panel-business" aria-selected="false" data-tab="business">{paths.business.tab}</button>
      </div>
      <div class="paths reveal">
        {(["agency", "business"] as const).map((k) => {
          const p = paths[k];
          return (
            <div class={`path${k === "agency" ? " on" : ""}`} role="tabpanel" id={`panel-${k}`} aria-labelledby={`tab-${k}`} data-panel={k}>
              <div class="path-copy">
                <div class="diagram" aria-hidden="true">
                  {p.diagram.map((n, i) => <>{i > 0 && <span class="d-wire"><i></i></span>}<span class={`d-node${n === "Weld" ? " weld" : ""}`}>{n === "Weld" ? <svg viewBox="0 0 100 100"><path d={W} /></svg> : null}{n}</span></>)}
                </div>
                <h3 class="h3">{p.title}</h3>
                <p class="lead">{p.lead}</p>
                <a href="#contacto" class="btn btn-dark magnetic" data-who={k === "agency" ? "Agência" : "Negócio"}>{p.cta}<Fragment set:html={arrow} /></a>
              </div>
              <ul class="checks">
                {p.points.map((pt, i) => <li style={`--i:${i}`}><span class="check" aria-hidden="true"></span>{pt}</li>)}
              </ul>
            </div>
          );
        })}
      </div>
    </section>

    <!-- SERVIÇOS -->
    <section class="section wrap" id="servicos">
      <h2 class="h2 reveal">{services.title}</h2>
      <div class="svc-grid">
        {services.items.map((s, i) => (
          <article class="svc card-fx reveal" style={`--i:${i}`}>
            <span class="svc-icon"><i class={`ph-duotone ${s.icon}`}></i></span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- PROCESSO -->
    <section class="section wrap" id="processo">
      <h2 class="h2 reveal">{process.title}</h2>
      <ol class="steps" id="steps">
        <span class="steps-line" aria-hidden="true"><span class="steps-fill"></span></span>
        {process.steps.map((s, i) => (
          <li class="step reveal" style={`--i:${i}`}>
            <span class="step-n"><i class={`ph-bold ${s.icon}`}></i></span>
            <span class="step-k">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- MODELOS DE NEGÓCIO -->
    <section class="section wrap" id="negocio">
      <div class="head">
        <h2 class="h2 reveal">{deals.title}</h2>
        <p class="lead reveal">{deals.lead}</p>
      </div>
      <div class="deals">
        {deals.items.map((d, i) => (
          <article class="deal card-fx reveal" style={`--i:${i}`}>
            <span class="deal-icon"><i class={`ph-duotone ${d.icon}`}></i></span>
            <span class="deal-for">{d.for}</span>
            <h3>{d.name}</h3>
            <p>{d.text}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- EQUIPA -->
    <section class="section wrap" id="equipa">
      <div class="team-panel reveal">
        <div class="team-copy">
          <h2 class="h2">Duas pessoas.<br />Um ponto de contacto.</h2>
          <p class="lead">Tudo chega primeiro ao João. Depois dividimos o trabalho, ou fazemos a dois quando o projeto pede.</p>
        </div>
        <div class="team">
          {team.map((m) => (
            <article class="member">
              <span class="avatar" aria-hidden="true">{m.initials}</span>
              <div>
                <h3>{m.name}</h3>
                <p class="role">{m.role}</p>
                <p class="bio">{m.text}</p>
                <div class="member-links">
                  {m.linkedin && <a href={m.linkedin} target="_blank" rel="noopener"><i class="ph-fill ph-linkedin-logo"></i>LinkedIn</a>}
                  {m.email && <a href={`mailto:${m.email}`}><i class="ph ph-envelope-simple"></i>Email</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section wrap narrow" id="faq">
      <h2 class="h2 reveal">{faq.title}</h2>
      <div class="faq reveal">
        {faq.items.map(([q, a]) => (
          <details>
            <summary>{q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CONTACTO -->
    <section class="section wrap" id="contacto">
      <div class="contact reveal">
        <svg class="contact-w" viewBox="0 0 100 100" aria-hidden="true"><path d={W} /></svg>
        <div class="contact-copy">
          <h2 class="h2">{contact.title}</h2>
          <p class="lead">{contact.lead}</p>
          <div class="direct">
            <button class="copy" type="button" id="copy-email" data-email={contacts.email}><i class="ph ph-envelope-simple"></i><span id="copy-label">{contacts.email}</span><small>copiar</small></button>
            <div class="direct-row">
              <a href={team[0].linkedin} target="_blank" rel="noopener" class="direct-link"><i class="ph-fill ph-linkedin-logo"></i>LinkedIn</a>
              <a href={contacts.instagram} target="_blank" rel="noopener" class="direct-link"><i class="ph ph-instagram-logo"></i>Instagram</a>
            </div>
          </div>
        </div>

        <form class="brief" id="brief" data-email={contacts.email} novalidate>
          <ol class="brief-steps" aria-hidden="true"><li class="on">1</li><li>2</li><li>3</li></ol>
          <fieldset class="brief-step on" data-step="1">
            <legend>Quem és?</legend>
            <div class="opts">{contact.who.map((w) => <button type="button" class="opt big" data-field="who" data-value={w}><i class={`ph-duotone ${w === "Agência" ? "ph-megaphone" : "ph-storefront"}`}></i>{w}</button>)}</div>
          </fieldset>
          <fieldset class="brief-step" data-step="2">
            <legend>O que precisas?</legend>
            <div class="opts">{contact.needs.map((n) => <button type="button" class="opt" data-field="need" data-value={n}>{n}</button>)}</div>
            <button type="button" class="back" data-back>Voltar</button>
          </fieldset>
          <fieldset class="brief-step" data-step="3">
            <legend>Só mais isto.</legend>
            <label for="f-name">Nome</label>
            <input id="f-name" name="name" autocomplete="name" required />
            <label for="f-company">Empresa ou agência</label>
            <input id="f-company" name="company" autocomplete="organization" />
            <label for="f-msg">Em duas linhas, o que querem resolver?</label>
            <textarea id="f-msg" name="msg" rows="3"></textarea>
            <p class="err" id="f-err" hidden>Falta o nome.</p>
            <div class="brief-actions">
              <button type="button" class="back" data-back>Voltar</button>
              <button type="submit" class="btn btn-mint">Abrir email pronto<Fragment set:html={arrow} /></button>
            </div>
          </fieldset>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer wrap">
    <span class="brand small"><svg viewBox="0 0 100 100" class="brand-icon" aria-hidden="true"><rect width="100" height="100" rx="22" fill="#0A2119" /><path d={W} fill="none" stroke="#fff" stroke-width="13" stroke-linecap="round" stroke-linejoin="round" /></svg>weld</span>
    <span>Assistentes de IA e automação · {contacts.city}</span>
    <span class="foot-links"><a href={`mailto:${contacts.email}`}>{contacts.email}</a><a href={team[0].linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={contacts.instagram} target="_blank" rel="noopener">{contacts.instagramHandle}</a></span>
  </footer>

  <script is:inline define:vars={{ demoData: demos.items }}>window.WELD_DEMOS = demoData;</script>
</Base>

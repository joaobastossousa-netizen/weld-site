---
import Base from "../layouts/Base.astro";
import Stage from "../components/Stage.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { landing, ways, examples, demos, integrations, faq, home, site } from "../content";
const W = "M12 20 L32 78 L50 40 L68 78 L88 20";
const HOT = "IA";
// o título parte-se em letras para entrarem uma a uma e reagirem ao rato
let n = 0;
const lines = landing.hero.map((l) => l.split(/(\s+)/).filter(Boolean).map((word) => ({ word, hot: word === HOT, chars: [...word].map((c) => ({ c, i: n++ })) })));
const ICON: Record<string, string> = { "O teu negócio": "ph-storefront", "Agência": "ph-megaphone", "Cliente da agência": "ph-users-three" };
const { inputs, outputs } = landing.canvas;
const sep = [",", ",", " e", "."];
const tone = ["dark", "paper", "deep", "paper"];
---
<Base title="Weld · Soldamos IA ao teu negócio" description={home.lead}>

  <!-- CAPA: título enorme, duas entradas e o editor de fluxos a correr -->
  <section class="hero5" data-chapter="dark" id="topo">
    <div class="wrap-wide">
      <p class="h5-meta h5-anim"><span>{landing.meta[0]}</span><span class="h5-meta-r"><span>{landing.meta[1]}</span><span><b data-clock>--:--</b></span></span></p>
      <div class="h5-head">
        <h1 class="h5-title pre">
          <span class="sr">{landing.hero.join(" ")}</span>
          {lines.map((words, li) => (
            <span class="h5-line" aria-hidden="true" data-line={li}>
              {words.map((w) => w.word.trim() === "" ? <span class="sp"> </span> : (
                <span class={`wd${w.hot ? " hot" : ""}`}>{w.chars.map(({ c, i }) => <span class="ch" style={`--i:${i}`}>{c}</span>)}</span>
              ))}
            </span>
          ))}
        </h1>
        <p class="h5-lead h5-anim">{landing.heroLead}</p>
      </div>
      <div class="h5-row">
        {landing.entries.map(([t, s2, href], i) => (
          <a href={href} class={`entry h5-anim${i === 0 ? " hot" : ""}`}><span><b>{t}</b><small>{s2}</small></span><i class="ph ph-arrow-right"></i></a>
        ))}
        <a href="/contacto?demo" class="h5-note h5-anim"><span>{landing.heroNote}</span><b class="u-link">Pedir demo grátis</b></a>
      </div>
    </div>

    <div class="wrap-wide flow-stage">
      <div class="flow" aria-label="Exemplo de um fluxo da Weld: mensagens e faturas a entrar, a Weld no meio, marcações e registos a sair">
        <div class="flow-bar">
          <div class="flow-tabs"><span class="on">Editor</span><span>Execuções</span><span>Testes</span></div>
          <span class="flow-name">Fluxo <b>Clínica do Porto</b><em>exemplo</em></span>
        </div>
        <svg class="flow-wires" aria-hidden="true">
          <defs>
            <radialGradient id="pkt-g"><stop offset="0" stop-color="#EFFFF6" /><stop offset=".3" stop-color="#8FE0B8" stop-opacity=".9" /><stop offset="1" stop-color="#5CC596" stop-opacity="0" /></radialGradient>
          </defs>
        </svg>
        {inputs.map((d, k) => (
          <div class={`node node-in n-${d.id}`} data-id={d.id} data-to={d.to} data-cursor="Arrastar" style={`--x:${[4, 3, 6][k]}%;--y:${[18, 44, 70][k]}%`}>
            <span class="node-ic"><img src={`/logos/${d.logo}.svg`} alt="" width="22" height="22" /></span>
            <span class="node-t"><small>{d.app}</small><b>{d.title}</b><em>{d.detail}</em></span>
            <i class="port out"></i>
          </div>
        ))}
        <div class="node core" data-id="weld" data-cursor="Arrastar" style="--x:39%;--y:30%">
          <div class="core-head">
            <span class="core-w"><svg viewBox="0 0 100 100"><path d={W} /></svg></span>
            <span><b>Weld</b><small>Assistente e automações</small></span>
            <span class="core-spin" aria-hidden="true"></span>
          </div>
          <div class="core-field"><small>Sabe</small><span>Preços, horários e regras da casa</span></div>
          <div class="core-field"><small>Se não souber</small><span>Passa a uma pessoa da equipa</span></div>
          <i class="port in"></i><i class="port out"></i>
        </div>
        {outputs.map((d, k) => (
          <div class={`node node-out n-${d.id}`} data-id={d.id} data-cursor="Arrastar" style={`--x:${[74, 77, 73][k]}%;--y:${[14, 43, 72][k]}%`}>
            <i class="port in"></i>
            <span class="node-ic"><img src={`/logos/${d.logo}.svg`} alt="" width="22" height="22" /></span>
            <span class="node-t"><small>{d.app}</small><b>{d.title}</b><em>{d.detail}</em></span>
            <span class="node-ok"><i class="ph-bold ph-check"></i></span>
          </div>
        ))}
        <div class="flow-foot">
          <span class="flow-tools" aria-hidden="true"><span><i class="ph ph-magnifying-glass-plus"></i></span><span><i class="ph ph-magnifying-glass-minus"></i></span><span><i class="ph ph-arrows-out-simple"></i></span></span>
          <button class="flow-run" type="button"><i class="ph-fill ph-play"></i>Testar fluxo</button>
          <span class="flow-log" aria-live="polite"><i></i><span class="flow-log-t">À espera de mensagens</span></span>
          <span class="flow-count"><b data-runs>1 284</b> execuções</span>
        </div>
      </div>
      <p class="flow-cap"><span>Um fluxo como os que construímos. Arrasta os blocos, ou carrega em Testar fluxo.</span><span>Dados de exemplo</span></p>
    </div>
  </section>

  <!-- POSICIONAMENTO: frase editorial com fotos dentro do texto -->
  <section class="mani" data-chapter="paper">
    <div class="wrap-wide">
      <p class="mani-text">
        O teu negócio já tem as peças:
        {landing.manifesto.pieces.map(([w, img], i) => (
          <><span class="pc"><img src={`/img/${img}`} alt="" loading="lazy" /></span>{w}{sep[i]} </>
        ))}
        <span class="mani-mute">Só não falam umas com as outras.</span>
        <span class="mani-hot">Nós soldamo-las.</span>
      </p>
      <div class="mani-foot">
        <p class="mani-side reveal">{landing.manifesto.text}</p>
        <ul class="proofs">
          {landing.manifesto.proofs.map(([a, b], i) => <li class="reveal" style={`--i:${i}`}><span class="pf-n">{String(i + 1).padStart(2, "0")}</span><b>{a}</b><span>{b}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- DUAS FORMAS: direto ou através de uma agência -->
  <section class="s5 ways5" id="como-trabalhamos" data-chapter="paper">
    <div class="wrap-wide">
      <header class="s5-head">
        <h2 class="s5-h" data-rise><span class="ln"><span>Duas formas de</span></span><span class="ln"><span>trabalhar connosco.</span></span></h2>
        <p class="s5-lead reveal">{ways.lead}</p>
      </header>
      <div class="w5">
        {ways.items.map((w, i) => (
          <a href={w.href} class={`w5-card w5-${w.key} reveal`} style={`--i:${i}`} data-cursor={w.cta}>
            <div class="w5-img"><img src={`/img/way-${w.key}.jpg`} alt="" width="1000" height="560" loading="lazy" /><span class="w5-tag">{String(i + 1).padStart(2, "0")}</span></div>
            <div class="w5-body">
              <p class="w5-k">{w.label}</p>
              <div class="w5-flow" aria-hidden="true">
                {w.flow.map((nm, k) => (
                  <>
                    {k > 0 && <span class="d-wire"><i style={`animation-delay:${k * 0.4}s`}></i></span>}
                    <span class={`d-node${nm === "Weld" ? " weld" : ""}`}>{nm === "Weld" ? <svg viewBox="0 0 100 100"><path d={W} /></svg> : <i class={`ph-duotone ${ICON[nm]}`}></i>}{nm}</span>
                  </>
                ))}
              </div>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
              <ul>{w.points.map((p) => <li>{p}</li>)}</ul>
              <span class="w5-cta">{w.cta}<i class="ph ph-arrow-right"></i></span>
            </div>
          </a>
        ))}
      </div>
      <div class="rs reveal">
        <h3>{ways.resale.title}</h3>
        <div>
          <ol>{ways.resale.steps.map(([, t, p2], i) => <li><span class="rs-n">{String(i + 1).padStart(2, "0")}</span><b>{t}</b><span>{p2}</span></li>)}</ol>
          <div class="rs-win">{ways.resale.win.map(([t, p2]) => <p><b>{t}</b>{p2}</p>)}</div>
          <a href="/agencias" class="u-link">{ways.resale.cta}<i class="ph ph-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVIÇOS: quatro cartões que se empilham -->
  <section class="s5 svc5" id="servicos" data-chapter="dark">
    <div class="wrap-wide">
      <header class="s5-head">
        <h2 class="s5-h" data-rise><span class="ln"><span>Quatro coisas</span></span><span class="ln"><span>que soldamos.</span></span></h2>
        <p class="s5-lead reveal">Podes começar por uma e juntar as outras quando fizer sentido. A maioria começa pelo assistente.</p>
      </header>
      <div class="stack">
        {examples.tabs.map((t, i) => (
          <article class={`sk sk-${tone[i]}`} style={`--i:${i}`}>
            <div class="sk-in">
              <div class="sk-copy">
                <p class="sk-n"><span>{String(i + 1).padStart(2, "0")} / 04</span><span>{t.label}</span></p>
                <h3>{t.title}</h3>
                <ul>{t.items.map((it) => <li>{it}</li>)}</ul>
                <a href={t.href} class="u-link">Ver {t.label.charAt(0).toLowerCase() + t.label.slice(1)}<i class="ph ph-arrow-right"></i></a>
              </div>
              <div class="sk-stage" aria-hidden="true"><Stage kind={t.key} /></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DEMOS: um ecrã que se endireita com o scroll -->
  <section class="s5 demo5" id="demos" data-chapter="dark">
    <div class="wrap-wide">
      <header class="s5-head">
        <h2 class="s5-h" data-rise><span class="ln"><span>Experimenta antes</span></span><span class="ln"><span>de falar connosco.</span></span></h2>
        <p class="s5-lead reveal">{demos.lead}</p>
      </header>
    </div>
    <div class="mon-wrap showcase">
      <div class="mon">
        <div class="browser-bar"><i></i><i></i><i></i><span class="demo-url">weldstudio.pt/demos/{demos.items[0].slug}</span></div>
        <div class="browser-view">
          {demos.items.map((d, i) => <video class={`demo-video${i === 0 ? " on" : ""}`} src={`/videos/${d.slug}.mp4`} poster={`/videos/${d.slug}.jpg`} muted playsinline preload={i === 0 ? "auto" : "none"} aria-label={`Vídeo da demo ${d.brand}`}></video>)}
        </div>
      </div>
      <div class="mon-ui">
        <div class="demo-list" role="tablist" aria-label="Demos">
          {demos.items.map((d, i) => (
            <button class={`demo-item${i === 0 ? " on" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} style={`--c:${d.color};--ink:${d.ink}`}>
              <span class="demo-mark">{d.brand.charAt(0)}</span>
              <span class="demo-txt"><b>{d.brand}</b><small>{d.sector}</small></span>
              <span class="demo-bar"><i></i></span>
            </button>
          ))}
        </div>
        <div class="demo-info">
          {demos.items.map((d, i) => (
            <div class={`demo-desc${i === 0 ? " on" : ""}`} data-slug={d.slug}>
              <p>{d.what}</p>
              <a class="btn btn-mint" href={`/demos/${d.slug}/index.html`} target="_blank" rel="noopener">Experimentar<i class="ph ph-arrow-up-right"></i></a>
            </div>
          ))}
        </div>
      </div>
      <p class="demo-note wrap-wide">{demos.note}</p>
    </div>
  </section>

  <!-- CALCULADORA -->
  <section class="s5 calc5" id="calculadora" data-chapter="paper">
    <div class="wrap-wide">
      <header class="s5-head">
        <h2 class="s5-h" data-rise><span class="ln"><span>Quanto te custa</span></span><span class="ln"><span>fazer à mão?</span></span></h2>
        <p class="s5-lead reveal">Mexe nos valores do teu negócio. Fazemos as contas ao tempo que hoje vai para trabalho que dá para automatizar.</p>
      </header>
      <div class="calc-box reveal">
        <div class="calc-in">
          <label class="rng"><span><b>Mensagens de clientes por dia</b><output data-o="msg">40</output></span><input type="range" min="0" max="200" step="5" value="40" data-k="msg" /></label>
          <label class="rng"><span><b>Minutos por resposta</b><output data-o="min">4</output></span><input type="range" min="1" max="15" step="1" value="4" data-k="min" /></label>
          <label class="rng"><span><b>Horas por semana em tarefas repetidas</b><small>copiar dados, faturas, relatórios</small><output data-o="rep">6</output></span><input type="range" min="0" max="40" step="1" value="6" data-k="rep" /></label>
          <label class="rng"><span><b>Custo de uma hora da equipa</b><output data-o="eur">12 €</output></span><input type="range" min="6" max="50" step="1" value="12" data-k="eur" /></label>
        </div>
        <div class="calc-out">
          <p class="co-k">Por mês, vai para trabalho automatizável</p>
          <p class="co-h"><b data-r="hours">0</b><span>horas</span></p>
          <div class="co-bars">
            <span><i data-bar="msg"></i><small>Mensagens</small><em data-r="hmsg">0 h</em></span>
            <span><i data-bar="rep"></i><small>Tarefas repetidas</small><em data-r="hrep">0 h</em></span>
          </div>
          <p class="co-e">≈ <b data-r="eur">0 €</b> em tempo da equipa, todos os meses</p>
          <p class="co-d"><b data-r="days">0</b> dias de trabalho por mês</p>
          <a href="/contacto?demo" class="btn btn-mint magnetic">Ver isto a funcionar no meu negócio<i class="ph ph-arrow-right"></i></a>
          <p class="co-note">Estimativa com os números que puseste, a contar 22 dias úteis por mês.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESSO: linha de solda na horizontal, presa ao scroll -->
  <section class="proc5" id="processo" data-chapter="dark">
    <div class="proc-pin">
      <header class="wrap-wide proc-head">
        <h2 class="s5-h" data-rise><span class="ln"><span>Do primeiro café</span></span><span class="ln"><span>ao fluxo ligado.</span></span></h2>
        <p class="proc-hint"><i class="ph ph-arrow-down"></i>Continua a descer</p>
      </header>
      <div class="proc-track">
        <div class="proc-seam" aria-hidden="true"><i class="proc-fill"></i><i class="proc-spark"></i></div>
        {landing.process.map(([when, t, p], i) => (
          <article class="pstep">
            <span class="ps-dot" aria-hidden="true"></span>
            <p class="ps-when">{when}</p>
            <span class="ps-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{t}</h3>
            <p>{p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SETORES E FERRAMENTAS: letreiros a correr -->
  <section class="sect5" data-chapter="paper" aria-label="Setores e ferramentas">
    <p class="wrap-wide sect-k">Se os teus clientes escrevem, marcam ou encomendam, dá para automatizar.</p>
    <div class="mq" data-marquee data-speed="70">
      <div class="mq-track">
        {landing.sectors.map(([nm, img]) => <span class="mq-i">{nm}<span class="mq-img"><img src={`/img/${img}`} alt="" loading="lazy" /></span></span>)}
      </div>
    </div>
    <div class="mq mq-tools" data-marquee="rev" data-speed="34">
      <div class="mq-track">
        {integrations.items.map(([slug, nm]) => <span class="tool5"><img src={`/logos/${slug}.svg`} alt="" width="22" height="22" loading="lazy" />{nm}</span>)}
      </div>
    </div>
  </section>

  <div data-chapter="paper" class="faq5">
    <Faq items={faq.items} />
  </div>

  <CtaBand />
  <script>import "../scripts/home.js";</script>
</Base>

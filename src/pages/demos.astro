---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { demos } from "../content";
---
<Base title="Demos · Weld" description={demos.lead}>
  <section class="page-hero wrap">
    <nav class="crumbs load" aria-label="Caminho"><a href="/">Início</a><i class="ph ph-caret-right"></i><span>Demos</span></nav>
    <p class="kicker load" style="--d:1"><span class="dot"></span>Demos</p>
    <h1 class="h1 load" style="--d:2">{demos.title}</h1>
    <p class="lead load" style="--d:3">{demos.lead}</p>
  </section>

  <section class="wrap demo-rows">
    {demos.items.map((d, i) => (
      <article class={`demo-row reveal ${i % 2 ? "flip" : ""}`} style={`--c:${d.color}`}>
        <div class="browser">
          <div class="browser-bar"><i></i><i></i><i></i><span>weldstudio.pt/demos/{d.slug}</span></div>
          <div class="browser-view"><video class="demo-video on autoplay-in-view" src={`/videos/${d.slug}.mp4`} poster={`/videos/${d.slug}.jpg`} muted playsinline loop preload="none" aria-label={`Vídeo da demo ${d.brand}`}></video></div>
        </div>
        <div class="demo-row-txt">
          <span class="demo-mark" style={`--ink:${d.ink}`}>{d.brand.charAt(0)}</span>
          <h2 class="h3">{d.brand}</h2>
          <p class="demo-sector-lg">{d.sector}</p>
          <p class="lead">{d.what}</p>
          <div class="chips">{d.tags.map((t) => <span class="chip-lg">{t}</span>)}</div>
          <div class="hero-ctas">
            <a class="btn btn-mint magnetic" href={`/demos/${d.slug}/index.html`} target="_blank" rel="noopener">Experimentar<i class="ph ph-arrow-up-right"></i></a>
            <a class="btn btn-ghost" href={`/demos/${d.slug}/demo.html`} target="_blank" rel="noopener">Ir direto à conversa</a>
          </div>
        </div>
      </article>
    ))}
    <p class="demo-note center">{demos.note}</p>
  </section>
  <CtaBand title="Queres uma demo com o teu negócio?" text="Fazemos de graça, com os teus preços, serviços e marca. Apresentamos em 20 minutos e só depois falamos de proposta." />
</Base>
